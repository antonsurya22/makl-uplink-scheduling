<?xml version="1.0"?>
<package format="3">
  <name>network_aware_nav</name>
  <version>0.0.1</version>
  <description>Network-aware navigation experiments for ROS 2 service robots.</description>

  <maintainer email="your_email@example.com">Anton</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>naw_interfaces</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
</package>
