#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rclpy.serialization import serialize_message

from sensor_msgs.msg import Image
from std_msgs.msg import String, Float32


CAP_MBPS = {
    'normal': None,       # unlimited
    'mild': 10.0,
    'moderate': 5.0,
    'severe': 1.0,
}


class CameraBandwidthLimiter(Node):

    def __init__(self):
        super().__init__('camera_bandwidth_limiter')

        self.active_profile = 'normal'
        self.last_tx_ns = None

        self.window_received = 0
        self.window_forwarded = 0

        self.image_pub = self.create_publisher(
            Image,
            '/camera/tx_bw',
            qos_profile_sensor_data
        )

        self.image_sub = self.create_subscription(
            Image,
            '/camera/tx',
            self.image_callback,
            qos_profile_sensor_data
        )

        self.profile_sub = self.create_subscription(
            String,
            '/network_profile',
            self.profile_callback,
            10
        )

        self.cap_pub = self.create_publisher(
            Float32,
            '/camera_bw_cap_mbps',
            10
        )

        self.drop_pub = self.create_publisher(
            Float32,
            '/camera_bw_drop_ratio',
            10
        )

        self.create_timer(
            0.5,
            self.publish_diagnostics
        )

        self.get_logger().info(
            'CameraBandwidthLimiter started: '
            '/camera/tx -> /camera/tx_bw'
        )

    def profile_callback(self, msg):
        profile = str(msg.data).lower()

        if profile not in CAP_MBPS:
            self.get_logger().warning(
                f"Unknown network profile '{profile}', ignored"
            )
            return

        if profile == self.active_profile:
            return

        old = self.active_profile
        self.active_profile = profile

        # Important: reset state between conditions.
        self.last_tx_ns = None
        self.window_received = 0
        self.window_forwarded = 0

        cap = CAP_MBPS[profile]

        self.get_logger().info(
            f'Bandwidth condition changed: '
            f'{old} -> {profile}, '
            f'cap={"unlimited" if cap is None else str(cap) + " Mbps"}'
        )

    def image_callback(self, msg):
        self.window_received += 1

        cap_mbps = CAP_MBPS[self.active_profile]

        # NORMAL: pass everything.
        if cap_mbps is None:
            self.image_pub.publish(msg)
            self.window_forwarded += 1
            self.last_tx_ns = self.get_clock().now().nanoseconds
            return

        # Serialized ROS message size.
        try:
            message_bytes = len(serialize_message(msg))
        except Exception:
            # Conservative fallback.
            message_bytes = len(msg.data) + 256

        message_bits = float(message_bytes) * 8.0
        cap_bps = float(cap_mbps) * 1e6

        # Minimum simulated-time spacing needed for this frame size
        # under the selected bandwidth cap.
        min_interval_ns = int(
            (message_bits / cap_bps) * 1e9
        )

        now_ns = self.get_clock().now().nanoseconds

        if self.last_tx_ns is None:
            self.image_pub.publish(msg)
            self.window_forwarded += 1
            self.last_tx_ns = now_ns
            return

        if (now_ns - self.last_tx_ns) >= min_interval_ns:
            self.image_pub.publish(msg)
            self.window_forwarded += 1
            self.last_tx_ns = now_ns

    def publish_diagnostics(self):
        cap = CAP_MBPS[self.active_profile]

        cap_msg = Float32()
        cap_msg.data = (
            -1.0 if cap is None else float(cap)
        )
        self.cap_pub.publish(cap_msg)

        drop_msg = Float32()

        if self.window_received > 0:
            drop_msg.data = float(
                1.0 -
                (self.window_forwarded / self.window_received)
            )
        else:
            drop_msg.data = 0.0

        self.drop_pub.publish(drop_msg)

        self.window_received = 0
        self.window_forwarded = 0


def main(args=None):
    rclpy.init(args=args)

    node = CameraBandwidthLimiter()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
