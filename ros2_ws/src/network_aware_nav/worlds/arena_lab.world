            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <sensor name="pedestrian_contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>100.0</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
          <plugin name="pedestrian_contact_plugin" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/dynamic_pedestrian</namespace>
              <remapping>bumper_states:=contacts</remapping>
            </ros>
            <frame_name>world</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
